{
  "family": "epa-task-${ENVIRONMENT}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "epa",
      "image": "${IMAGE_URI}",
      "essential": true,
      "environment": [
        { "name": "ENVIRONMENT", "value": "${ENVIRONMENT}" }
      ],
      "secrets": [
        { "name": "user",     "valueFrom": "${SECRETS_ARN}:user::" },
        { "name": "password", "valueFrom": "${SECRETS_ARN}:password::" },
        { "name": "account",  "valueFrom": "${SECRETS_ARN}:account::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      }
    }
  ]
}
